{
	"name": "osmrouter-desktop",
	"productName": "osmRouter",
	"version": "1.2.1",
	"description": "osmRouter desktop \u2014 expose your local ports at public URLs.",
	"author": "osmRouter <contact@osmapi.com>",
	"homepage": "https://osmrouter.com",
	"license": "MIT",
	"main": "main.js",
	"scripts": {
		"postinstall": "node scripts/fetch-binary.js",
		"start": "electron .",
		"dist": "electron-builder",
		"dist:mac": "electron-builder --mac",
		"dist:win": "electron-builder --win"
	},
	"devDependencies": {
		"electron": "33.2.1",
		"electron-builder": "25.1.8"
	},
	"build": {
		"appId": "com.osmapi.osmrouter",
		"productName": "osmRouter",
		"directories": {
			"output": "release"
		},
		"files": [
			"main.js",
			"preload.js",
			"lib/**",
			"renderer/**",
			"assets/**"
		],
		"extraResources": [
			{
				"from": "bin",
				"to": "bin"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			],
			"icon": "assets/icon.png"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "assets/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
